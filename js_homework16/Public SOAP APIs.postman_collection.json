  "item": [
    {
      "name": "Book ISBN Numbers",
      "item": [
        {
          "name": "ISBN 13",
          "item": [
            {
              "name": "Is Valid ISBN13 Number",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test(\"Status code is 200\", function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "",
                      "pm.test(\"Header 'Content-Type' is present\", function () {",
                      "    pm.response.to.have.header(\"Content-Type\");",
                      "});",
                      "",
                      "pm.test(\"Content-Type is text/xml\", function () {",
                      "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/xml\");",
                      "});",
                      "",
                      "pm.test(\"Response time is less than 3000ms\", function () {",
                      "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                      "});",
                      "",
                      "pm.test(\"Raw response body contains IsValidISBN13Result\", function () {",
                      "    pm.expect(pm.response.text()).to.include(\"IsValidISBN13Result\");",
                      "});",
                      "",
                      "var jsonObject;",
                      "pm.test(\"Successfully converted XML to JSON object\", function () {",
                      "    jsonObject = xml2Json(pm.response.text());",
                      "    pm.expect(jsonObject).to.be.an('object');",
                      "});",
                      "",
                      "pm.test(\"JSON structure contains 'soap:Envelope'\", function () {",
                      "    pm.expect(jsonObject).to.have.property(\"soap:Envelope\");",
                      "});",
                      "",
                      "pm.test(\"JSON structure contains 'soap:Body'\", function () {",
                      "    pm.expect(jsonObject[\"soap:Envelope\"]).to.have.property(\"soap:Body\");",
                      "});",
                      "",
                      "pm.test(\"JSON structure contains 'm:IsValidISBN13Response'\", function () {",
                      "    pm.expect(jsonObject[\"soap:Envelope\"][\"soap:Body\"]).to.have.property(\"m:IsValidISBN13Response\");",
                      "});",
                      "",
                      "pm.test(\"ISBN number is VALID (Result is 'true')\", function () {",
                      "    var result = jsonObject[\"soap:Envelope\"][\"soap:Body\"][\"m:IsValidISBN13Response\"][\"m:IsValidISBN13Result\"];",
                      "    pm.expect(result).to.eql(\"true\");",
                      "});"
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "text/xml; charset=utf-8",
                    "type": "text"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <IsValidISBN13 xmlns=\"http://webservices.daehosting.com/ISBN\">\n      <sISBN>978-1-4612-9090-2</sISBN>\n    </IsValidISBN13>\n  </soap:Body>\n</soap:Envelope>"
                },
                "url": {
                  "raw": "http://webservices.daehosting.com/services/isbnservice.wso",
                  "protocol": "http",
                  "host": [
                    "webservices",
                    "daehosting",
                    "com"
                  ],
                  "path": [
                    "services",
                    "isbnservice.wso"
                  ]
                },
                "description": "The test is done by calculation on the first 12 digits and compare the result with the checksum number at the end. You have to pass a 13 digits number."
              },
              "response": []
            }
          ]
        },
